# RainMail 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# Flask 密钥 (请使用随机生成的强密码)
SECRET_KEY=your-secret-key-here

# 邮件配置
MAIL_SERVER=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-password
MAIL_DEFAULT_SENDER=your-email@example.com
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_ENABLED=true

# 管理员账户 (建议使用密码哈希，而非明文)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here

# 人机验证配置
CAPTCHA_PROVIDER=altcha
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret
ALTCHA_HMAC_KEY=your-altcha-hmac-key
ALTCHA_DIFFICULTY=3

# AI 内容审核 (可选)
AI_MODERATION_API_KEY=your-ai-api-key
AI_MODERATION_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODERATION_MODEL=deepseek-ai/deepseek-r1-distill-llama-8b

# TOTP 双因素认证
TOTP_DECRYPT_PASSWORD=your-totp-decrypt-password

# 微信公众号配置 (可选)
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# 和风天气 API
HEFENG_KEY1=your-hefeng-key1
HEFENG_HOST1=your-hefeng-host1

# 位置配置
LOCATION_ID=101280101
LOCATION_NAME=广州

# 其他配置
VERIFY_DURATION_MINUTES=15
TIMES=3600
FORCE_RAIN_DURATION=10
PRIVATE_DELIVERY_REQUIRE_LOGIN=false
